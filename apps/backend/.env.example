# ─────────────────────────────────────────────────────────────────────────────
# Sistema Paz y Salvo — Backend (apps/backend / @pys/api). Copia a `.env`.
# El backend valida estas variables con Zod al arrancar (fail-fast). Los SECRETOS
# viven solo aquí (gitignored) — NUNCA en código, commits ni memoria.
# ─────────────────────────────────────────────────────────────────────────────

# --- Base de datos (requerido) -----------------------------------------------
# Cadena de conexión PostgreSQL de Supabase: Project Settings → Database →
# Connection string (usa el pooler para serverless). Incluye sslmode=require.
DATABASE_URL=postgresql://postgres:<password>@db.vwcnqrdicjarkorqdrue.supabase.co:5432/postgres

# --- Supabase Auth (requerido) -----------------------------------------------
# URL del proyecto (Settings → API).
SUPABASE_URL=https://vwcnqrdicjarkorqdrue.supabase.co
# Secreto para verificar el JWT de Supabase (Settings → API → JWT Settings →
# JWT Secret). Con él, `jose` valida el token que envía el frontend (HS256).
SUPABASE_JWT_SECRET=<jwt-secret-de-supabase>

# --- Identidad y dominio (con defaults) --------------------------------------
# Correo que se promueve a superadministrador en su primer login.
SUPERADMIN_EMAIL=leonardoreales@americana.edu.co
# Buzón que recibe el aviso cuando Talento Humano genera una liquidación.
CONTROL_INTERNO_EMAIL=leonardoreales@americana.edu.co
# Dominio institucional permitido para autoregistro (otros correos: rechazados).
DOMINIO_PERMITIDO=americana.edu.co

# --- Servidor (con defaults) -------------------------------------------------
# Puerto del API. DEBE ser 3000 en local (OAuth de Supabase está atado a :3000).
PORT=3000
# Origen del frontend permitido por CORS. En local, el dev server de Vite.
WEB_ORIGIN=http://localhost:5173

# --- Notificación por correo (opcional) --------------------------------------
# Sin RESEND_API_KEY, el aviso se registra en consola (modo log) y el cambio de
# estado igual se guarda.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# EMAIL_FROM=Paz y Salvo <onboarding@resend.dev>
