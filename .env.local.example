# ============================================================================
# Sistema Paz y Salvo — Variables de entorno
# Copia este archivo a `.env.local` y completa los valores.
# ============================================================================

# Fuente de datos:
#   "memory"   -> store en memoria sembrado con datos reales del Excel.
#                 Funciona SIN configurar nada (ideal para la demo y desarrollo).
#   "supabase" -> usa la base PostgreSQL de Supabase (producción).
DATA_SOURCE=memory

# --- Solo requeridas si DATA_SOURCE=supabase --------------------------------
# Las obtienes en: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Llave de servicio (NO exponer al cliente). Solo se usa en el servidor.
SUPABASE_SERVICE_ROLE_KEY=
