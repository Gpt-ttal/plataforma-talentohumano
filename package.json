{
  "name": "sistema-paz-y-salvo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "apps/backend",
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently --kill-others --names \"API,WEB\" --prefix-colors \"blue.bold,magenta.bold\" \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "npm run dev --workspace=apps/backend",
    "dev:safe": "node scripts/dev-safe.mjs",
    "build": "npm run build --workspace=shared && npm run build --workspace=apps/backend && npm run build --workspace=apps/web",
    "test": "npm run test --workspace=shared && npm run test --workspace=apps/backend && npm run test --workspace=apps/web",
    "loadtest": "node scripts/loadtest.mjs",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "autocannon": "^7.15.0",
    "concurrently": "^10.0.3",
    "pg": "^8.22.0",
    "prettier": "^3.8.4",
    "tsx": "^4.22.4",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8",
    "xlsx": "^0.18.5"
  }
}
